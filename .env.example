PUBLIC_ONLINE_ENABLED=false
PUBLIC_ONLINE_SERVER_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:5173,https://cs13a0.com,https://www.cs13a0.com
PORT=8080

# Servidor online: conta e coleção. Sem DATABASE_URL o servidor sobe só com salas anônimas.
DATABASE_URL=postgres://cs13a0:cs13a0@127.0.0.1:5435/cs13a0
# Magic link: em dev, AUTH_DEV_LINK=1 devolve o link na resposta em vez de enviar e-mail.
AUTH_DEV_LINK=1
RESEND_API_KEY=
AUTH_FROM=cs13a0 <login@cs13a0.com>
PUBLIC_SITE_URL=http://localhost:5173

# Mercado Pago (pagamento real). Sem as três variáveis a loja de coins fica desligada.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
PUBLIC_SERVER_URL=http://localhost:8080
